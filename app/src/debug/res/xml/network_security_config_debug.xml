<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug/QA only: permit a user-installed CA for the isolated Mac mini
         test endpoint. Release builds do not package this resource override. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
